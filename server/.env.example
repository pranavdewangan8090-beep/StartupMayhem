# Copy to .env and fill in. Never commit the real .env.
# Only used by one-off scripts run against the DB directly (scripts/seedUsers.js,
# the psql seed:cards script) and by the RPC test suite (test/) — there is no
# deployed server that reads this.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
# Same public values as client/.env — the test suite calls Supabase exactly
# the way the browser does, logging in for real over PostgREST.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
