# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
NODE_ENV=production
# comma-separated list of the exact origins the deployed frontend is served from.
# CORS_ORIGINS=* accepts any origin (handy on event WiFi where phones land on a
# different LAN IP each time) but also disables the Origin-based CSRF check —
# fine for a short trusted-network event, not for anything left running long-term.
CORS_ORIGINS=https://your-frontend.example.com
